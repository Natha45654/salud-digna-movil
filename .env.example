# Copia este archivo como .env y completa los valores. El archivo .env no se
# versiona. Se lee al compilar o ejecutar:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --debug --dart-define-from-file=.env
# Una variable vacía equivale a no definida.
#
# El modo y la URL se fijan al compilar: la app no permite cambiarlos. Para
# cambiar de entorno se compila e instala otro APK.

# true: orquestador simulado dentro de la app (sin red, datos de prueba).
# false: API central real de Salud Digna.
# Vacío equivale a true.
MOCK_MODE=

# Origen de la API central, solo con https://. SIN "/api/v1": la app añade
# "/api/v1" por su cuenta (si se escribe, se quita para no duplicarlo).
# Vacío equivale a https://api.salud-digna.app, que la app usa como
# https://api.salud-digna.app/api/v1. Solo se usa con MOCK_MODE=false.
# La app solo envía el JWT del paciente: aquí no van claves ni credenciales.
CHANNEL_BACKEND_URL=

# true: "¿Necesitas ayuda?" abre el simulador de WhatsApp (saluddigna-wa://)
# en lugar de wa.me. Vacío equivale a false.
WHATSAPP_SIMULATOR=

# Números de contacto, solo dígitos con lada (por ejemplo 52 + 10 dígitos para
# WhatsApp). Vacíos: se abre WhatsApp o el marcador sin número.
SD_WHATSAPP=
SD_CALL_CENTER=
